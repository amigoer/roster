{
  "name": "@roster/ext-qoder-cli",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Qoder CLI for Roster: the Qoder coding agent over the Agent Client Protocol",
  "roster": {
    "api": 2,
    "type": "qoder-cli",
    "label": "Qoder CLI",
    "acp": {
      "command": [
        "@program",
        "--acp",
        "--permission-mode",
        "default"
      ],
      "login": {
        "terminal": [
          "qoder",
          "login"
        ]
      },
      "permissionModes": false,
      "fixedEnv": {
        "QODER_NO_RC": "1"
      }
    }
  }
}
