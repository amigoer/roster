{
  "name": "@roster/ext-codex",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Codex for Roster: OpenAI's coding agent over the Agent Client Protocol",
  "roster": {
    "api": 2,
    "type": "codex",
    "label": "Codex",
    "acp": {
      "command": [
        "@program"
      ],
      "env": {
        "openai-responses": {
          "baseUrl": "OPENAI_BASE_URL",
          "key": "OPENAI_API_KEY"
        },
        "openai-completions": {
          "baseUrl": "OPENAI_BASE_URL",
          "key": "OPENAI_API_KEY"
        }
      },
      "login": {
        "terminal": [
          "codex",
          "login"
        ]
      }
    }
  }
}
